# ローカル開発用（.env にコピーして使う）。本番の値は enebular 側の envVars に入れる。
# 雛形値（change-me / 000...0）は「未設定」と同じ扱いになる（src/config.ts）。

# ---- 動作モード ----------------------------------------------------------
LOG_LEVEL=INFO
PORT=8787

# ---- 認証 ----------------------------------------------------------------
# セッションと QR の署名鍵。本番は 32 文字以上のランダム文字列にする
SESSION_SECRET=local-dev-secret-not-for-production
# 先生のログインパスワード
TEACHER_PASSWORD=teacher
# QR の有効秒数（短いほどスクリーンショットの使い回しが効かない）
QR_TTL_SEC=300
# ログインの有効時間（時間）
SESSION_TTL_HOURS=168
# 学校の識別子（英数字・_・-）。1 校 1 デプロイなら既定のままでよい
TENANT_ID=default

# ---- データストア --------------------------------------------------------
# memory: インメモリ実装に切り替える（ローカル専用・永続化されない）
# cloud : 実行環境が注入する接続情報を使う（ローカルからは使えない）
DATASTORE_MODE=memory
# テーブル ID は enebular コンソール → データストア → テーブル → 設定タブ
DS_TABLE_ROSTER=00000000-0000-0000-0000-000000000000
DS_TABLE_EVENTS=00000000-0000-0000-0000-000000000000
DS_TABLE_CHECKINS=00000000-0000-0000-0000-000000000000

# ---- 任意: HTML 全体に BASIC 認証を掛ける（両方そろったときだけ有効） ----------
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
