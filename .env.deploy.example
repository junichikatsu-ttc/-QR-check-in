# deploy.mjs（npm run enebular:*）の設定。.env.deploy にコピーして値を入れる（git 管理外）。
# 同名の環境変数があればそちらが優先。コメントは行頭 # のみ（値の後ろに書かない）。

# ===== enebular CLI（デプロイ操作用。アカウント設定画面で発行） =====
# 未設定なら CLI 側の ~/.enebular/credentials（default プロファイル）で認証する
ENEBULAR_ACCESS_KEY=
ENEBULAR_SECRET_KEY=

# コンソールで作成したプロジェクトの ID
ENEBULAR_PROJECT_ID=
# 空のまま `npm run enebular:init` を実行するとファイルアセットが作成され、ここに書き戻される
ENEBULAR_FILE_ASSET_ID=
ENEBULAR_FILE_ASSET_NAME=qr-checkin-function
# コンソールで作成したクラウド実行環境の ID（アセット作成後に作る。ランタイム Node.js 22.x）
ENEBULAR_CLOUD_ID=
# 任意: クラウド実行環境の表示名を変える（1〜30 文字の英数字 _ -）
# ENEBULAR_CLOUD_NAME=qr-checkin-staging

# HTTP トリガーのパス（先頭スラッシュなし。インスタンス内で一意）
ENEBULAR_HTTP_TRIGGER_PATH=qr-checkin
# トリガーの URL（例: https://xxxx.enebular.com/qr-checkin）。スモークテストで使う。空ならスキップ
ENEBULAR_HTTP_TRIGGER_URL=
# 関数のタイムアウト秒（1〜900）
ENEBULAR_TIMEOUT=30

# ===== 関数の環境変数（FN_ を外して envVars として `npm run enebular:config` で送る） =====
# 送った内容で置き換わる。ここに無いキーは実行環境から消える
FN_LOG_LEVEL=INFO
# セッションと QR の署名鍵。32 文字以上のランダム文字列（例: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"）
FN_SESSION_SECRET=
# 先生のログインパスワード
FN_TEACHER_PASSWORD=
FN_QR_TTL_SEC=300
FN_SESSION_TTL_HOURS=168
FN_TENANT_ID=default
# データストア → テーブル → 設定タブのテーブル ID
FN_DS_TABLE_ROSTER=
FN_DS_TABLE_EVENTS=
FN_DS_TABLE_CHECKINS=
# 任意: HTML 全体に BASIC 認証を掛ける
FN_BASIC_AUTH_USER=
FN_BASIC_AUTH_PASSWORD=
